# The password required to enter the site.
# Set this yourself in .env.local (for local dev) and in your Vercel
# project's Environment Variables (for production). Never commit it,
# and there's no need to share it with anyone else, including in chat.
SITE_PASSWORD=

# Optional — lets the contact form actually email you when a message is
# sent. Uses Resend (https://resend.com), which has a free tier.
# Leave these blank and the form will still show "Thank you." — it just
# won't deliver the message anywhere.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
